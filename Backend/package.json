{
  "name": "cityconnect-backend",
  "version": "1.0.0",
  "description": "CityConnect Node.js + MongoDB backend",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "init-db": "node scripts/initDatabase.js",
    "seed-db": "node scripts/seedMinimalDatabase.js",
    "backup-db": "node scripts/backup.js",
    "restore-db": "node scripts/restore.js",
    "db-stats": "node scripts/dbStats.js",
    "cleanup-db": "node scripts/cleanup.js",
    "test": "jest --config tests/jest.config.js --detectOpenHandles",
    "test:unit": "jest --config tests/jest.unit.config.js",
    "test:watch": "jest --config tests/jest.config.js --watch",
    "test:coverage": "jest --config tests/jest.config.js --coverage",
    "test:integration": "jest --config tests/jest.config.js tests/integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "cityconnect",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "csv-parse": "^5.6.0",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "mongoose": "^8.8.4",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@shelf/jest-mongodb": "^4.3.2",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.1.1"
  }
}
